# Server-side configuration. Set these in the process/hosting environment.
# The app does not automatically load .env files.
# Groq is the default provider, using GPT-OSS 20B.
STUDYBUDDY_PROVIDER=groq
GROQ_API_KEY=
# Optional local setup: set STUDYBUDDY_PROVIDER=lmstudio to use Qwen.
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_API_KEY=
LMSTUDIO_TIMEOUT=180
